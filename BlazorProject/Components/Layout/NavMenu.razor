@rendermode InteractiveServer
@using BlazorProject.Data.Models
@using BlazorProject.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject LanguageService Lang

<div class="sb-wrapper">

    <!-- Header com user info -->
    <div class="sb-header">
        <div class="sb-user">
            <div class="sb-avatar">
                @if (!string.IsNullOrWhiteSpace(CurrentUser?.FotoCaminho))
                {
                    <img src="@CurrentUser.FotoCaminho" alt="Avatar do utilizador" />
                }
                else
                {
                    <span>👤</span>
                }
            </div>
            <div>
                <h2 class="sb-name">@GetDisplayName()</h2>
                <p class="sb-role">@GetRole()</p>
            </div>
        </div>
    </div>

    <!-- Navegação principal -->
    <nav class="sb-nav">

        @if (!IsAdmin)
        {
            <!-- Links de Médico -->
            <NavLink class="sb-link" href="dashboard" Match="NavLinkMatch.All">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/>
                    <rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
                </svg>
                @Lang.T("nav_dashboard")
            </NavLink>

            <NavLink class="sb-link" href="patients">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                @Lang.T("nav_patients")
            </NavLink>

            <NavLink class="sb-link" href="consultations">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                    <line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/>
                    <line x1="3" x2="21" y1="10" y2="10"/>
                </svg>
                @Lang.T("nav_consultations")
            </NavLink>

            <NavLink class="sb-link" href="reports">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/>
                    <line x1="6" x2="6" y1="20" y2="14"/>
                </svg>
                @Lang.T("nav_reports")
            </NavLink>
            
            <NavLink class="sb-link" href="profile">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="7" r="4"/>
                    <path d="M5.5 21a6.5 6.5 0 0 1 13 0"/>
                </svg>
                @Lang.T("nav_profile")
            </NavLink>
        }
        else
        {
            <!-- Links de Administração -->
            <div class="sb-section-label">@Lang.T("nav_administration")</div>

            <NavLink class="sb-link" href="user-management">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M19 8v6"/><path d="M22 11h-6"/>
                </svg>
                @Lang.T("nav_user_management")
            </NavLink>

            <NavLink class="sb-link" href="global-records">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5" rx="9" ry="3"/>
                    <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                    <path d="M3 12A9 3 0 0 0 21 12"/>
                </svg>
                @Lang.T("nav_global_records")
            </NavLink>
        }

    </nav>

    <!-- Footer com botão Sair e toggle de tema -->
    <div class="sb-footer">
        <button class="sb-theme-toggle" @onclick="ToggleTheme" title="@(_isDark ? Lang.T("nav_light_mode") : Lang.T("nav_dark_mode"))">
            @if (_isDark)
            {
                <!-- Ícone sol (modo claro) -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
                <span>@Lang.T("nav_light_mode")</span>
            }
            else
            {
                <!-- Ícone lua (modo escuro) -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <span>@Lang.T("nav_dark_mode")</span>
            }
        </button>

        <button class="sb-logout" @onclick="HandleLogout">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
            @Lang.T("nav_logout")
        </button>
    </div>

</div>

@implements IDisposable

@code {
    private Utilizador? CurrentUser => LoggedInUserContext.CurrentUser;
    private bool IsAdmin => CurrentUser?.IsAdmin ?? false;
    private bool _isDark = false;

    protected override void OnInitialized()
    {
        LoggedInUserContext.CurrentUserChanged += HandleCurrentUserChanged;
        Lang.LanguageChanged += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("themeManager.initTheme");
            _isDark = theme == "dark";

            var lang = await JS.InvokeAsync<string>("languageManager.getLanguage");
            Lang.Init(lang);

            StateHasChanged();
        }
    }

    private void HandleCurrentUserChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LoggedInUserContext.CurrentUserChanged -= HandleCurrentUserChanged;
        Lang.LanguageChanged -= HandleLanguageChanged;
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("themeManager.setTheme", _isDark ? "dark" : "light");
    }

    private void HandleLogout()
    {
        LoggedInUserContext.Clear();
        NavigationManager.NavigateTo("/");
    }

    private string GetDisplayName() =>
        string.IsNullOrWhiteSpace(CurrentUser?.Nome) ? "Utilizador" : CurrentUser.Nome;

    private string GetRole() =>
        IsAdmin ? "Administrador" :
        string.IsNullOrWhiteSpace(CurrentUser?.Especialidade) ? "Médico" : CurrentUser.Especialidade!;
}