@page "/profile"
@using BlazorProject.Data.Models
@using BlazorProject.Services
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Environment
@inject UtilizadorService UtilizadorService
@inject ConsultasService ConsultasService
@inject LanguageService Lang
@implements IDisposable

<PageTitle>@Lang.T("profile_title")</PageTitle>

@if (IsLoading)
{
    <div class="text-center py-5">@Lang.T("profile_loading")</div>
}
else if (CurrentUser is null)
{
    <div class="text-center py-5 text-muted">@Lang.T("profile_redirecting")</div>
}
else
{
    <div class="max-w-2xl mx-auto d-flex flex-column gap-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="h3 mb-2">@Lang.T("profile_title")</h1>
                <p class="text-muted mb-0">@Lang.T("profile_subtitle")</p>
            </div>
        </div>
        @CurrentUser.FotoNome
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Lang.T("profile_photo")</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrWhiteSpace(CurrentUser?.FotoCaminho))
                {
                    <img src="@CurrentUser.FotoCaminho" alt="Foto de Perfil" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:120px;height:120px;font-size:2rem;">👤</div>
                }

                <div class="mb-3">
                    <label class="form-label">@Lang.T("profile_select_photo")</label>
                    <InputFile OnChange="HandleProfilePhotoSelected" accept="image/*" />
                    @if (!string.IsNullOrWhiteSpace(SelectedProfilePhotoName))
                    {
                        <div class="small text-muted mt-1">@Lang.T("profile_selected_file"): @SelectedProfilePhotoName</div>
                    }
                </div>
                <button class="btn btn-primary btn-sm" type="button" @onclick="SaveProfileAsync" disabled="@(string.IsNullOrWhiteSpace(SelectedProfilePhotoName))">
                    @Lang.T("profile_save_photo")
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Lang.T("profile_personal_info")</h5>
                @if (!IsEditingPersonal)
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => IsEditingPersonal = true">
                        <span class="me-2">✎</span>
                        @Lang.T("profile_edit")
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!IsEditingPersonal)
                {
                    <div class="space-y-4">
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">👤</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_full_name")</p>
                                <p class="fw-semibold mb-0">@CurrentUser.Nome</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">🆔</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_username")</p>
                                <p class="fw-semibold mb-0">@CurrentUser.Username</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">✉️</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_email")</p>
                                <p class="fw-semibold mb-0">@CurrentUser.Email</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">💼</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_specialty")</p>
                                <p class="fw-semibold mb-0">@(!string.IsNullOrWhiteSpace(CurrentUser.Especialidade) ? CurrentUser.Especialidade : Lang.T("profile_not_defined_f"))</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">📞</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_phone")</p>
                                <p class="fw-semibold mb-0">@(!string.IsNullOrWhiteSpace(CurrentUser.Telefone) ? CurrentUser.Telefone : Lang.T("profile_not_defined"))</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <form onsubmit="return false;">
                        <div class="mb-3">
                            <label class="form-label" for="nome">@Lang.T("profile_full_name") *</label>
                            <input id="nome" class="form-control" @bind="FormData.Nome" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="username">@Lang.T("profile_username") *</label>
                            <input id="username" class="form-control" @bind="FormData.Username" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="email">@Lang.T("profile_email") *</label>
                            <input id="email" type="email" class="form-control" @bind="FormData.Email" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="especialidade">@Lang.T("profile_specialty")</label>
                            <input id="especialidade" class="form-control" placeholder="Ex: Cardiologia" @bind="FormData.Especialidade" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="telefone">@Lang.T("profile_phone")</label>
                            <input id="telefone" class="form-control" placeholder="+351 912 345 678" @bind="FormData.Telefone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="senha">Nova Senha (deixe em branco para não alterar)</label>
                            <input id="senha" type="password" class="form-control" placeholder="••••••" @bind="FormData.Senha" />
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button class="btn btn-primary flex-grow-1" type="button" @onclick="SaveProfileAsync">@Lang.T("profile_save_changes")</button>
                            <button class="btn btn-outline-secondary flex-grow-1" type="button" @onclick="CancelEditPersonal">@Lang.T("profile_cancel")</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Lang.T("profile_address")</h5>
                @if (!IsEditingAddress)
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => IsEditingAddress = true">
                        <span class="me-2">✎</span>
                        @Lang.T("profile_edit")
                    </button>
                }
            </div>
            <div class="card-body">
                @if (!IsEditingAddress)
                {
                    <div class="space-y-4">
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">🏠</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_street")</p>
                                <p class="fw-semibold mb-0">@(!string.IsNullOrWhiteSpace(CurrentUser.Rua) ? CurrentUser.Rua : Lang.T("profile_not_defined_f"))</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">#</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_door_number")</p>
                                <p class="fw-semibold mb-0">@(!string.IsNullOrWhiteSpace(CurrentUser.NumPorta) ? CurrentUser.NumPorta : Lang.T("profile_not_defined"))</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <span class="fs-5 text-secondary">📮</span>
                            <div class="flex-grow-1">
                                <p class="text-muted small mb-0">@Lang.T("profile_postal_code")</p>
                                <p class="fw-semibold mb-0">@(!string.IsNullOrWhiteSpace(CurrentUser.CodPostal) ? CurrentUser.CodPostal : Lang.T("profile_not_defined"))</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <form onsubmit="return false;">
                        <div class="mb-3">
                            <label class="form-label" for="rua">@Lang.T("profile_street")</label>
                            <input id="rua" class="form-control" placeholder="Ex: Avenida da Liberdade" @bind="FormData.Rua" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="numPorta">@Lang.T("profile_door_number")</label>
                            <input id="numPorta" class="form-control" placeholder="Ex: 12A" @bind="FormData.NumPorta" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="codPostal">@Lang.T("profile_postal_code")</label>
                            <input id="codPostal" class="form-control" placeholder="Ex: 1000-001" @bind="FormData.CodPostal" />
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button class="btn btn-primary flex-grow-1" type="button" @onclick="SaveProfileAsync">@Lang.T("profile_save_changes")</button>
                            <button class="btn btn-outline-secondary flex-grow-1" type="button" @onclick="CancelEditAddress">@Lang.T("profile_cancel")</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Lang.T("profile_consultation_invites")</h5>
                <span class="badge bg-primary">@PendingInvites.Count</span>
            </div>
            <div class="card-body">
                @if (PendingInvites.Count == 0)
                {
                    <div class="text-muted text-center py-3">@Lang.T("profile_no_pending_invites")</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var invite in PendingInvites)
                        {
                            <div class="p-3 border rounded bg-light">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@invite.PatientName</div>
                                        <div class="small text-muted">@Lang.T("profile_invited_by"): @invite.OwnerName</div>
                                        @if (invite.StartAt is not null)
                                        {
                                            <div class="small text-muted">@Lang.T("profile_start"): @invite.StartAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </div>
                                    <span class="badge bg-warning text-dark">@Lang.T("profile_pending")</span>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-sm btn-success" @onclick="() => AcceptInviteAsync(invite.IdConsulta)">@Lang.T("profile_accept")</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeclineInviteAsync(invite.IdConsulta)">@Lang.T("profile_decline")</button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick='() => NavigationManager.NavigateTo($"/invites/{invite.IdConsulta}")'>@Lang.T("profile_view_consultation")</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">@Lang.T("profile_preferences")</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <label class="form-label mb-0 fw-semibold" for="langSelect">🌐 @Lang.T("profile_language")</label>
                    <select id="langSelect" class="form-select w-auto" @bind="SelectedLanguage" @bind:after="OnLanguageChangedAsync">
                        @foreach (var lang in LanguageService.AvailableLanguages)
                        {
                            <option value="@lang.Key">@lang.Value</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsEditingPersonal;
    private bool IsEditingAddress;
    private bool IsLoading = true;

    private Utilizador? CurrentUser;
    private ProfileForm FormData { get; set; } = new();
    private List<ConsultasService.PendingInviteItem> PendingInvites { get; set; } = [];
    private IBrowserFile? SelectedProfilePhoto;
    private string? SelectedProfilePhotoName;
    private string SelectedLanguage = "pt";

    protected override void OnInitialized()
    {
        Lang.LanguageChanged += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        SelectedLanguage = Lang.CurrentLanguage;
        await LoadUserAsync();
    }

    private void HandleLanguageChanged()
    {
        SelectedLanguage = Lang.CurrentLanguage;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Lang.LanguageChanged -= HandleLanguageChanged;
    }

    private async Task OnLanguageChangedAsync()
    {
        Lang.SetLanguage(SelectedLanguage);
        await JSRuntime.InvokeVoidAsync("languageManager.setLanguage", SelectedLanguage);
    }

    private async Task LoadUserAsync()
    {
        CurrentUser = LoggedInUserContext.CurrentUser;

        if (CurrentUser is null)
        {
            IsLoading = false;
            NavigationManager.NavigateTo("/");
            return;
        }

        ResetForm();
        PendingInvites = await ConsultasService.GetPendingInvitesForDoctorAsync(CurrentUser.IdUtilizador);
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ResetForm()
    {
        if (CurrentUser is null) return;

        FormData = new ProfileForm
        {
            Nome = CurrentUser.Nome,
            Username = CurrentUser.Username,
            Email = CurrentUser.Email,
            Especialidade = CurrentUser.Especialidade ?? string.Empty,
            Telefone = CurrentUser.Telefone ?? string.Empty,
            Rua = CurrentUser.Rua ?? string.Empty,
            NumPorta = CurrentUser.NumPorta ?? string.Empty,
            CodPostal = CurrentUser.CodPostal ?? string.Empty,
            Senha = string.Empty
        };

        SelectedProfilePhoto = null;
        SelectedProfilePhotoName = null;
    }

    private void HandleProfilePhotoSelected(InputFileChangeEventArgs e)
    {
        SelectedProfilePhoto = e.File;
        SelectedProfilePhotoName = SelectedProfilePhoto?.Name;
    }

    private async Task SaveProfileAsync()
    {
        if (CurrentUser is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (string.IsNullOrWhiteSpace(FormData.Nome) || string.IsNullOrWhiteSpace(FormData.Username) || string.IsNullOrWhiteSpace(FormData.Email))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Nome, username e email são obrigatórios.");
            return;
        }

        if (!Regex.IsValidEmail(FormData.Email))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Email inválido.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(FormData.Telefone) && !Regex.IsValidPhoneNumber(FormData.Telefone))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Número de telefone inválido.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(FormData.CodPostal) && !Regex.IsValidPostalCode(FormData.CodPostal))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Código postal inválido. Formato esperado: XXXX-XXX.");
            return;
        }

        string? profilePhotoName = CurrentUser.FotoNome;
        string? profilePhotoPath = CurrentUser.FotoCaminho;
        if (SelectedProfilePhoto is not null)
        {
            var upload = await SaveUploadedFileAsync(SelectedProfilePhoto, "profiles");
            if (upload is null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Não foi possível salvar a foto de perfil.");
                return;
            }

            var (originalFileName, relativePath) = upload.Value;
            profilePhotoName = originalFileName;
            profilePhotoPath = relativePath;
        }

        var updatedUser = new Utilizador(
            CurrentUser.IdUtilizador,
            CurrentUser.IsManager,
            CurrentUser.IsAdmin,
            FormData.Nome.Trim(),
            FormData.Username.Trim(),
            string.IsNullOrWhiteSpace(FormData.Senha) ? CurrentUser.Password : FormData.Senha,
            string.IsNullOrWhiteSpace(FormData.Telefone) ? null : FormData.Telefone.Trim(),
            FormData.Email.Trim(),
            string.IsNullOrWhiteSpace(FormData.NumPorta) ? null : FormData.NumPorta.Trim(),
            string.IsNullOrWhiteSpace(FormData.Rua) ? null : FormData.Rua.Trim(),
            string.IsNullOrWhiteSpace(FormData.CodPostal) ? null : FormData.CodPostal.Trim(),
            CurrentUser.NumCarteira,
            string.IsNullOrWhiteSpace(FormData.Especialidade) ? null : FormData.Especialidade.Trim(),
            profilePhotoName,
            profilePhotoPath,
            CurrentUser.CodPostalNavigation);

        var savedUser = await UtilizadorService.UpdateAsync(updatedUser);
        CurrentUser = savedUser;
        LoggedInUserContext.SetCurrentUser(savedUser);

        IsEditingPersonal = false;
        IsEditingAddress = false;
        ResetForm();
        await JSRuntime.InvokeVoidAsync("alert", Lang.T("profile_updated_success"));
    }

    private async Task AcceptInviteAsync(int idConsulta)
    {
        if (CurrentUser is null)
        {
            return;
        }

        var result = await ConsultasService.AcceptInviteAsync(CurrentUser.IdUtilizador, idConsulta);
        if (!result.Ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", result.Message);
            return;
        }

        PendingInvites = await ConsultasService.GetPendingInvitesForDoctorAsync(CurrentUser.IdUtilizador);
    }

    private async Task DeclineInviteAsync(int idConsulta)
    {
        if (CurrentUser is null)
        {
            return;
        }

        var result = await ConsultasService.DeclineInviteAsync(CurrentUser.IdUtilizador, idConsulta);
        if (!result.Ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", result.Message);
            return;
        }

        PendingInvites = await ConsultasService.GetPendingInvitesForDoctorAsync(CurrentUser.IdUtilizador);
    }

    private void CancelEditPersonal()
    {
        IsEditingPersonal = false;
        ResetForm();
    }

    private void CancelEditAddress()
    {
        IsEditingAddress = false;
        ResetForm();
    }

    private sealed class ProfileForm
    {
        public string Nome { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Especialidade { get; set; } = string.Empty;
        public string Telefone { get; set; } = string.Empty;
        public string Rua { get; set; } = string.Empty;
        public string NumPorta { get; set; } = string.Empty;
        public string CodPostal { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }

    private async Task<(string OriginalFileName, string RelativePath)?> SaveUploadedFileAsync(IBrowserFile file, string folder)
    {
        try
        {
            var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads", folder);
            Directory.CreateDirectory(uploadsFolder);
            var extension = Path.GetExtension(file.Name);
            var generatedFileName = $"{Guid.NewGuid()}{extension}";
            var fullPath = Path.Combine(uploadsFolder, generatedFileName);

            await using var fileStream = File.Create(fullPath);
            await using var sourceStream = file.OpenReadStream(1024 * 1024 * 20);
            await sourceStream.CopyToAsync(fileStream);

            return (file.Name, $"/uploads/{folder}/{generatedFileName}");
        }
        catch
        {
            return null;
        }
    }
}
